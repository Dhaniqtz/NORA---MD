# NORA MD backend configuration (copy to .env — never commit .env)

PORT=3000

# Persistent Baileys auth state (must survive restarts)
# SESSION_DIR=./session

# Runtime settings (status automation) and session backups
# DATA_DIR=./data

# Optional owner number in international format, digits only.
# When unset, the linked WhatsApp account is treated as the owner.
# OWNER_NUMBER=947XXXXXXXX

# Extra allowed frontend origins for CORS (comma separated, HTTPS, no wildcard)
# ALLOWED_ORIGINS=https://dashboard.example.com

# Dashboard authentication (optional). When set, pairing, settings and session
# reset require an unlock password entered in the dashboard; the browser only
# receives an HttpOnly session cookie.
# DASHBOARD_PASSWORD=

# Optional bearer token for server-to-server clients:
#   Authorization: Bearer <token>
# API_TOKEN=

# HMAC key for dashboard session cookies (optional)
# SESSION_SECRET=

# Pairing behaviour (milliseconds)
# PAIR_CODE_TTL_MS=180000
# PAIR_SOCKET_TIMEOUT_MS=20000
# PAIR_COOLDOWN_MS=30000

# Reconnect backoff (milliseconds)
# RECONNECT_BASE_DELAY=5000
# RECONNECT_MAX_DELAY=60000

# LOG_LEVEL=info
